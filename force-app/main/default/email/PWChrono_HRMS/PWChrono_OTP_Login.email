<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="margin:0;padding:20px;background-color:#f4f6f9;font-family:Arial,Helvetica,sans-serif;">
  <div style="max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
    <div style="background-color:#4e73df;padding:24px 32px;">
      <h1 style="color:#ffffff;margin:0;font-size:22px;font-weight:600;">PWChrono Portal</h1>
    </div>
    <div style="padding:32px;">
      <p style="color:#333333;font-size:16px;margin:0 0 16px;">Hello {!Recipient.FirstName},</p>
      <p style="color:#555555;font-size:15px;margin:0 0 24px;">Your one-time password (OTP) for PWChrono Portal login is:</p>
      <div style="background-color:#f8f9fc;padding:24px;text-align:center;border-radius:8px;margin:0 0 24px;border:1px solid #e3e6f0;">
        <span style="font-size:36px;font-weight:bold;letter-spacing:10px;color:#4e73df;font-family:'Courier New',monospace;">
          {!RelatedTo.One_Time_Password__c}
        </span>
      </div>
      <p style="color:#666666;font-size:14px;margin:0 0 8px;">This code will expire in <strong>10 minutes</strong>.</p>
      <p style="color:#999999;font-size:12px;margin:0;">If you did not request this code, please ignore this email and contact your HR Administrator.</p>
    </div>
    <div style="background-color:#f8f9fc;padding:16px 32px;border-top:1px solid #e3e6f0;">
      <p style="color:#aaaaaa;font-size:11px;margin:0;text-align:center;">This is an automated message from PWChrono HRMS. Please do not reply to this email.</p>
    </div>
  </div>
</body>
</html>
