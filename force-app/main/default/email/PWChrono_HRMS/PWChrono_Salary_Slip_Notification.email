<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:20px;background-color:#f4f6f9;font-family:Arial,Helvetica,sans-serif;">
  <div style="max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
    <div style="background-color:#4e73df;padding:24px 32px;">
      <h1 style="color:#ffffff;margin:0;font-size:22px;font-weight:600;">PWChrono Portal</h1>
      <p style="color:#c8d8ff;margin:6px 0 0;font-size:14px;">Payroll &amp; Compensation</p>
    </div>
    <div style="padding:32px;">
      <p style="color:#333333;font-size:16px;margin:0 0 16px;">Dear {!Recipient.FirstName},</p>
      <p style="color:#555555;font-size:15px;margin:0 0 24px;">Your salary slip for <strong>{!RelatedTo.Payroll_Period__c}</strong> is now available. Please find the summary below:</p>
      <table style="width:100%;border-collapse:collapse;margin:0 0 24px;">
        <tr style="background-color:#f8f9fc;">
          <td style="padding:12px 16px;border:1px solid #e3e6f0;color:#555;font-size:14px;width:50%;">Pay Period</td>
          <td style="padding:12px 16px;border:1px solid #e3e6f0;color:#333;font-weight:600;font-size:14px;">{!RelatedTo.Payroll_Period__c}</td>
        </tr>
        <tr>
          <td style="padding:12px 16px;border:1px solid #e3e6f0;color:#555;font-size:14px;">Gross Pay</td>
          <td style="padding:12px 16px;border:1px solid #e3e6f0;color:#333;font-weight:600;font-size:14px;">{!RelatedTo.Gross_Pay__c}</td>
        </tr>
        <tr style="background-color:#f8f9fc;">
          <td style="padding:12px 16px;border:1px solid #e3e6f0;color:#555;font-size:14px;">Total Deductions</td>
          <td style="padding:12px 16px;border:1px solid #e3e6f0;color:#e74a3b;font-weight:600;font-size:14px;">{!RelatedTo.Total_Deductions__c}</td>
        </tr>
        <tr>
          <td style="padding:14px 16px;border:1px solid #e3e6f0;color:#333;font-weight:700;font-size:15px;">Net Pay</td>
          <td style="padding:14px 16px;border:1px solid #e3e6f0;color:#1cc88a;font-weight:700;font-size:15px;">{!RelatedTo.Net_Pay__c}</td>
        </tr>
      </table>
      <p style="color:#555555;font-size:14px;margin:0;">Log in to the PWChrono Portal to view your full salary slip with a complete breakdown of earnings and deductions.</p>
    </div>
    <div style="background-color:#f8f9fc;padding:16px 32px;border-top:1px solid #e3e6f0;">
      <p style="color:#aaaaaa;font-size:11px;margin:0;text-align:center;">This is an automated message from PWChrono HRMS. Please do not reply to this email.</p>
    </div>
  </div>
</body>
</html>
